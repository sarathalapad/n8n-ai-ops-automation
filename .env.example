# Copy to .env and replace every value. Never commit .env.
# Generate random values with e.g.:  python -c "import secrets; print(secrets.token_hex(32))"

N8N_VERSION=latest
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-postgres-password
N8N_ENCRYPTION_KEY=change-me-64-hex-chars
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=UTC

# Shared secret n8n sends to the helper service (X-OpsGuard-Token header).
OPSGUARD_API_TOKEN=change-me-helper-token
# Optional comma-separated allow-list of approver identities.
OPSGUARD_APPROVERS=

# Incoming chat webhook (Slack / Teams / Mattermost / Google Chat) for notifications.
OPS_CHAT_WEBHOOK_URL=https://chat.example.invalid/webhook/placeholder
# Your runbook / automation engine (Rundeck, AWX, Azure Automation, an RPA orchestrator...).
RUNBOOK_API_URL=https://runbooks.example.invalid/api
